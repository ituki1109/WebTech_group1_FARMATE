# 初回に `.env.example` を `.env` にコピーして値を埋めてください。
# 実際のキーは `supabase start` のあと `npx supabase status -o env` で確認できます。
# （ANON_KEY → NEXT_PUBLIC_SUPABASE_ANON_KEY、SERVICE_ROLE_KEY → SUPABASE_SERVICE_ROLE_KEY）

# Docker コンテナからホスト上の Supabase にアクセスするための URL
NEXT_PUBLIC_SUPABASE_URL=http://host.docker.internal:54321

NEXT_PUBLIC_SUPABASE_ANON_KEY=<supabase status の ANON_KEY>
SUPABASE_SERVICE_ROLE_KEY=<supabase status の SERVICE_ROLE_KEY>
